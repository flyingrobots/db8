BEGIN;
SELECT plan(8);

-- scores_upgrade_unique_key() moves a legacy database to one score per judge
-- per participant per round. Legacy rows carry no reliable revision order: the
-- old score_submit updated a row on a nonce conflict without touching
-- created_at, so the newest created_at need not hold the latest values. Rows
-- with identical values collapse to one; rows that differ are refused, and the
-- operator chooses.

INSERT INTO rooms (id, title) VALUES ('21900000-0000-4000-8000-000000000101', 'scores upgrade');
INSERT INTO rounds (id, room_id, idx, phase, submit_deadline_unix) VALUES
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000101', 0, 'published', 0);
INSERT INTO participants (id, room_id, anon_name, role) VALUES
  ('21900000-0000-4000-8000-000000000111', '21900000-0000-4000-8000-000000000101', 'agent_1', 'debater'),
  ('21900000-0000-4000-8000-000000000112', '21900000-0000-4000-8000-000000000101', 'agent_2', 'debater'),
  ('21900000-0000-4000-8000-000000000113', '21900000-0000-4000-8000-000000000101', 'agent_3', 'debater'),
  ('21900000-0000-4000-8000-000000000119', '21900000-0000-4000-8000-000000000101', 'judge_1', 'judge');

-- Put the table back in its legacy shape.
ALTER TABLE scores DROP CONSTRAINT scores_round_id_judge_id_participant_id_key;
ALTER TABLE scores ADD CONSTRAINT scores_round_id_judge_id_participant_id_client_nonce_key
  UNIQUE (round_id, judge_id, participant_id, client_nonce);

-- agent_1: an older and a newer score that differ (the older may hold a later
-- correction). agent_2: two that tie and differ. agent_3: two identical.
INSERT INTO scores (round_id, judge_id, participant_id, e, r, c, v, y, client_nonce, created_at) VALUES
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
   '21900000-0000-4000-8000-000000000111', 10, 10, 10, 10, 10, 'old', now() - interval '1 minute'),
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
   '21900000-0000-4000-8000-000000000111', 90, 90, 90, 90, 90, 'new', now()),
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
   '21900000-0000-4000-8000-000000000112', 20, 20, 20, 20, 20, 'tie-a', now()),
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
   '21900000-0000-4000-8000-000000000112', 80, 80, 80, 80, 80, 'tie-b', now()),
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
   '21900000-0000-4000-8000-000000000113', 50, 50, 50, 50, 50, 'dup-a', now() - interval '1 minute'),
  ('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
   '21900000-0000-4000-8000-000000000113', 50, 50, 50, 50, 50, 'dup-b', now());

-- What db/preflight.sql does, committed before schema.sql runs.
INSERT INTO score_nonces (round_id, judge_id, participant_id, client_nonce)
SELECT round_id, judge_id, participant_id, client_nonce FROM scores
ON CONFLICT DO NOTHING;

SELECT throws_ok('SELECT scores_upgrade_unique_key()', 'P0001',
                 'scores_upgrade_ambiguous: 2 (round, judge, participant) with differing scores',
                 'differing scores are refused, whatever their created_at');

-- The operator keeps the 90 for agent_1 and the 80 for agent_2.
DELETE FROM scores WHERE client_nonce IN ('old', 'tie-a');
SELECT lives_ok('SELECT scores_upgrade_unique_key()', 'the upgrade runs once nothing differs');
SELECT is((SELECT e FROM scores WHERE participant_id = '21900000-0000-4000-8000-000000000111'),
          90, 'the score the operator kept stays');
SELECT is((SELECT count(*)::int FROM scores WHERE participant_id = '21900000-0000-4000-8000-000000000113'),
          1, 'identical scores collapse to one');
SELECT is((SELECT count(*)::int FROM pg_constraint WHERE conrelid = 'scores'::regclass
             AND pg_get_constraintdef(oid) = 'UNIQUE (round_id, judge_id, participant_id)'),
          1, 'the key no longer includes the nonce');

-- Nonces of removed rows stay known, so a delayed retry of one is a retry and
-- cannot overwrite the score that was kept.
SELECT is((SELECT count(*)::int FROM score_nonces
            WHERE round_id = '21900000-0000-4000-8000-000000000102'
              AND client_nonce IN ('old', 'tie-a', 'dup-a', 'dup-b')),
          4, 'the nonces of removed scores are recorded');
SELECT score_submit('21900000-0000-4000-8000-000000000102', '21900000-0000-4000-8000-000000000119',
                    '21900000-0000-4000-8000-000000000111', 10, 10, 10, 10, 10, 'old');
SELECT is((SELECT e FROM scores WHERE participant_id = '21900000-0000-4000-8000-000000000111'),
          90, 'a retry of a removed revision does not overwrite the kept score');
SELECT is((SELECT e FROM scores WHERE participant_id = '21900000-0000-4000-8000-000000000113'),
          50, 'the collapsed score keeps its value');

SELECT * FROM finish();
ROLLBACK;
