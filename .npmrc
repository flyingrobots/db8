# eslint-plugin-react 7.37.5 is the newest release that exists and its peer
# range stops at eslint ^9.7, so npm refuses an otherwise working tree. The
# range is stale metadata, not a real incompatibility: react/jsx-key was
# verified firing correctly under eslint 10, against a control config.
#
# Targeted `overrides` do not reach peerDependencies, so this is the remaining
# option. Remove it when eslint-plugin-react ships an eslint 10 peer.
legacy-peer-deps=true
