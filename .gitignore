# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Node / Core
# No trailing slash: that form matches directories only, so a symlink named
# node_modules (as git worktrees commonly need) would slip past and be committed
# as an absolute-path symlink. The bare name matches dirs, files and symlinks at
# any depth, so web/node_modules is covered too.
node_modules
.npm-cache/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.eslintcache
.cache/
.tmp*.prov*.json
/.tmp*

# Env files (keep an example committed separately)
.env
.env.local
.env.*.local

# db8 signing keys (local-only; never commit)
# The wildcard also covers the .tmp.<pid>.<rand> staging files used to publish
# the pair atomically; those are unlinked on success but can survive a crash.
.db8_signing_key*

# Next.js / Frontend
.next/
out/
.vercel/
.turbo/

# Builds / Bundles
dist/
build/

# Coverage
coverage/

# Editors / IDEs
.vscode/
.idea/
.obsidian/

# Supabase (CLI scratch + generated)
supabase/.temp/
supabase/generated/
.supabase/

.obsidian/

# Playwright artifacts
web/test-results/
web/playwright-report/
web/e2e/*.png

# Agent working notes (cool ideas, code-smell journal)
.claude/
