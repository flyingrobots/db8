# db8 configuration. Every value below is optional; the defaults shown are what
# the server uses when the variable is unset.
#
# The previous contents of this file listed three SUPABASE_* variables that no
# code in this repository reads. They have been removed.

# --- Core ---------------------------------------------------------------
# Postgres connection string. Unset, the server runs in memory mode, which is a
# supported mode rather than a degraded one.
# DATABASE_URL=postgresql://postgres:test@localhost:54329/db8_test
# NODE_ENV=development          # 'production' without DATABASE_URL returns 503
# PORT=3000

# --- Canonicalization ---------------------------------------------------
# How documents are canonicalized before hashing and signing. sorted|jcs.
# An unrecognized value is an error, not a silent fallback.
# CANON_MODE=jcs

# --- Cross-origin access ------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. Unset,
# defaults to http://localhost:3001,http://127.0.0.1:3001 (the dev web app).
# Serving the web app from anywhere else requires setting this or the browser
# blocks every request. See docs/Ops.md.
# DB8_ALLOWED_ORIGINS=https://db8.example.com

# --- Enforcement flags --------------------------------------------------
# ENFORCE_SERVER_NONCES=false
# ENFORCE_AUTHOR_BINDING=false
# ENFORCE_RATELIMIT=false

# --- Round windows (seconds) --------------------------------------------
# SUBMIT_WINDOW_SEC=300
# CONTINUE_WINDOW_SEC=300

# --- Signing keys -------------------------------------------------------
# Supply the PEMs directly, or point at files. Unset, a persistent pair is
# generated on first start.
# SIGNING_PRIVATE_KEY=
# SIGNING_PUBLIC_KEY=
# SIGNING_PRIVATE_KEY_PATH=
# SIGNING_PUBLIC_KEY_PATH=

# --- CLI ----------------------------------------------------------------
# DB8_API_URL=http://localhost:3000
# DB8_ROOM_ID=
# DB8_PARTICIPANT_ID=
# DB8_JWT=
# DB8_ANON=                     # submit anonymously
# DB8_CANON_MODE=               # CLI alias for CANON_MODE; does not affect the server

# --- Web app ------------------------------------------------------------
# Compiled into the browser bundle, so it must be reachable from the browser.
# NEXT_PUBLIC_DB8_API_URL=http://localhost:3000
